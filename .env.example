# HTTPS terminates at your external reverse proxy.
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080

POSTGRES_USER=openverse
POSTGRES_DB=openverse
# Use a random alphanumeric password (without %: Alembic uses ConfigParser).
POSTGRES_PASSWORD=replace-with-a-random-alphanumeric-password
# At least 32 characters. Generate a separate value, do not reuse the DB password.
SECRET_KEY=replace-with-a-separate-random-secret-at-least-32-characters
# Public HTTPS origin, without trailing slash. JSON array, single quotes are for dotenv.
WS_ALLOWED_ORIGINS='["https://chat.example.com"]'
